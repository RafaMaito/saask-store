# Configurações do Servidor (Server Environment Configuration)
PORT=5000
NODE_ENV=development

# Configuração do Banco de Dados MongoDB (MongoDB Database Connection Configuration)
MONGODB_URI=mongodb://127.0.0.1:27017/Saask_store_ai

# Autenticação e Segurança (Authentication & Security Keys)
JWT_SECRET=super_secret_jwt_key_saas_multi_tenant_2026_senior_key
JWT_EXPIRES_IN=7d

# Provedor de IA Padrão (Default Fallback AI Provider Options)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
